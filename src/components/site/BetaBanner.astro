---
/**
 * Sitewide opt-in to the Rimrock live-map beta.
 * Centered, mint/forest glass strip — matches V3 utility + section palette.
 *
 * GATED by Rimrock's pilot_portal (same as /new-reservations-pilot):
 * fail-closed — hidden until /api/pilot-status returns ok && open.
 * Owner toggles from Rimrock Admin → Settings → Online booking (pilot gate).
 */
---
<div class="crr-beta-banner" data-beta-banner hidden>
  <div class="v2-shell crr-beta-banner-inner">
    <a class="crr-beta-banner-link" href="/availability">
      <span class="crr-beta-banner-label">Live map beta</span>
      <span class="crr-beta-banner-copy">
        Try our new live map — pick a site in Rimrock, then call to confirm and pay your deposit
      </span>
      <span class="crr-beta-banner-go" aria-hidden="true">Try it →</span>
    </a>
  </div>
</div>
<script is:inline>
  (function () {
    var banner = document.querySelector('[data-beta-banner]');
    if (!banner) return;
    fetch('/api/pilot-status', { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (s) {
        if (s && s.ok === true && s.open === true) {
          banner.hidden = false;
        }
      })
      .catch(function () { /* stay hidden — fail closed */ });
  })();
</script>
